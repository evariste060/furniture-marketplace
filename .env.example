# Docker Compose settings. Copy this file to .env (repository root) and replace the placeholders.
# .env is git-ignored: never commit it.

# Owner account of the local PostgreSQL. Reuse these values in MIGRATION_DATABASE_URL (and
# TEST_DATABASE_URL) in backend/.env.
POSTGRES_USER=local_user
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=rwanda_ecommerce

# Host ports. If 5432 is already used on your machine, pick another (for example 55432) and use
# the same port in every database URL in backend/.env.
POSTGRES_PORT=5432
REDIS_PORT=6379
