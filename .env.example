# Docker Compose settings. Copy this file to .env (repository root) and replace the placeholders.
# .env is git-ignored: never commit it.

# Owner account of the local PostgreSQL. Reuse these values in MIGRATION_DATABASE_URL (and
# TEST_DATABASE_URL) in backend/.env.
POSTGRES_USER=local_user
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=rwanda_ecommerce

# Host ports. If 5432 is already used on your machine, pick another (for example 55433) and use
# the same port in every database URL in backend/.env; the same for Redis and REDIS_URL. The
# Compose project is named "furnihub", so its containers and its data volume are separate from
# the electronics project this repository was cloned from. Give each project its own ports too,
# so both can run at the same time.
POSTGRES_PORT=5432
REDIS_PORT=6379
