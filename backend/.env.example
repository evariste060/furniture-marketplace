# Backend settings. Copy this file to backend/.env and replace every placeholder.
# backend/.env is git-ignored: never commit it. Shell environment variables override it.

APP_NAME=Rwanda Electronics E-Commerce API
APP_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR or CRITICAL. Logs go to stderr; secrets, emails and
# phone numbers are redacted from every line.
LOG_LEVEL=INFO

# Comma-separated list of exact browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Runtime account used by the API: the least-privilege role "rwanda_app" with a new random
# password you choose. scripts/provision_runtime_role.py creates it from this line (user name and
# password are read from here), so it never has to be typed anywhere else.
# Use the same host, port and database as MIGRATION_DATABASE_URL. Port must match POSTGRES_PORT
# in the root .env.
DATABASE_URL=postgresql+psycopg://rwanda_app:REPLACE_WITH_RANDOM_APP_PASSWORD@127.0.0.1:5432/rwanda_ecommerce

# Schema-owner account, used only by Alembic and the operator scripts (provision_runtime_role.py,
# bootstrap_admin.py). Same user, password, port and database as POSTGRES_* in the root .env.
MIGRATION_DATABASE_URL=postgresql+psycopg://local_user:REPLACE_WITH_ROOT_ENV_POSTGRES_PASSWORD@127.0.0.1:5432/rwanda_ecommerce

# Shared login rate-limit store (all API workers/instances must use the same Redis).
# Port must match REDIS_PORT in the root .env.
REDIS_URL=redis://127.0.0.1:6379/0

# 32+ char random secret for audit/rate-limit identifier pseudonyms. Rotating it breaks linkage
# with older audit records. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
AUDIT_HMAC_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS

# Message delivery (password-reset codes, module 2; order notifications, module 17). No real SMS
# or email provider exists until ADR-005 (§7 Q22).
# none: order notifications are off; forgot/reset password answer 503.
# console: messages (and reset codes) are printed in the terminal; only with APP_ENV=development.
# mock: order notifications are recorded and "sent" to a stand-in that delivers nothing; password
# reset still answers 503; refused when APP_ENV=production.
# smtp: real email through the SMTP_* settings below (Gmail-compatible); email only, no SMS. Order
# messages go to the order's email address, and an order without one gets none. Password reset
# works by email; by phone it answers 503. Refused when APP_ENV=production until ADR-005, except
# the temporary Gmail test route below.
NOTIFICATION_PROVIDER=none

# SMTP (only with NOTIFICATION_PROVIDER=smtp). Gmail: turn on 2-Step Verification and create an app
# password; never use the account password. Keep the password in this git-ignored file or a secret
# store, and never commit it. STARTTLS with a verified certificate is required when credentials
# are set.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# Sender name shown in the inbox beside SMTP_FROM_EMAIL (optional).
# SMTP_FROM_NAME=FurniHub
# SMTP_TIMEOUT_SECONDS=10
# TEMPORARY: true lets APP_ENV=production send through Gmail for owner testing on Render, until
# Resend replaces Gmail. Off by default. Requires NOTIFICATION_PROVIDER=smtp, SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USE_TLS=true, SMTP_USERNAME, SMTP_PASSWORD and SMTP_FROM_EMAIL. Other production
# safeguards stay on, and the API logs a warning at every startup. Must be removed before final
# launch; change NOTIFICATION_PROVIDER first (docs/deployment/README.md).
# TEMPORARY_GMAIL_SMTP_ENABLED=false
# Transactional email (docs/deployment/email.md).
# EMAIL_ALLOWED_RECIPIENTS: comma-separated test inboxes. When set, email reaches these addresses
# only; any other recipient is recorded as refused and never sent. REQUIRED with
# NOTIFICATION_PROVIDER=smtp and APP_ENV=development. Leave empty on a deployment that must email
# real customers.
# EMAIL_ALLOWED_RECIPIENTS=you@example.com
# STAFF_ORDER_ALERT_EMAILS: comma-separated staff addresses told about every new order.
# STAFF_ORDER_ALERT_EMAILS=orders@example.com
# SITE_URL: the storefront origin used for the buttons in emails (https outside development).
# Unset: emails carry no links, and registration with an email cannot send its verification link
# (it answers 503 email_verification_unavailable).
# SITE_URL=http://localhost:3000

# Email verification of new customer accounts (ADR-006 amendment 2026-11-12). A customer who
# registers with an email gets a link to SITE_URL/verify-email#token=... and no session until it is
# used. Needs NOTIFICATION_PROVIDER=console (development) or smtp, and SITE_URL. Defaults shown.
# EMAIL_VERIFICATION_TTL_HOURS=24
# EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# EMAIL_VERIFICATION_RESEND_MAX_PER_EMAIL=5
# EMAIL_VERIFICATION_RESEND_MAX_PER_IP=20
# EMAIL_VERIFICATION_RESEND_WINDOW_SECONDS=3600
# Failed verification attempts per client network within the window.
# EMAIL_VERIFICATION_MAX_FAILURES_PER_IP=30
# EMAIL_VERIFICATION_FAILURE_WINDOW_SECONDS=900

# Cart abuse limits (module 11; docs/architecture/ADR-008-cart-security-controls.md): S1 approved 2026-10-24; S3 values retained, details pending.
# CART_GUEST_CREATIONS_PER_IP=10
# CART_GUEST_CREATION_WINDOW_SECONDS=3600
# CART_STOCK_REFUSALS_PER_WINDOW=20
# CART_STOCK_REFUSAL_WINDOW_SECONDS=900
# Promotion codes (module 13, ADR-008 S5, approved 2026-10-25): refused codes per network and per cart.
# CART_CODE_REFUSALS_PER_WINDOW=20
# CART_CODE_REFUSAL_WINDOW_SECONDS=900
# Guest order lookup (module 14, ADR-008 S6, approved 2026-10-25): failed lookups per order number and per IP.
# ORDER_LOOKUP_MAX_FAILURES_PER_ORDER=5
# ORDER_LOOKUP_MAX_FAILURES_PER_IP=20
# ORDER_LOOKUP_WINDOW_SECONDS=900
# Review submissions (module 20, SC-01): attempts per review link and per client network.
# REVIEW_SUBMIT_MAX_PER_TOKEN=5
# REVIEW_SUBMIT_MAX_PER_IP=20
# REVIEW_SUBMIT_WINDOW_SECONDS=3600
# Business quote requests (module 19): every request counts, per phone number and per network.
# QUOTE_REQUEST_MAX_PER_PHONE=3
# QUOTE_REQUEST_MAX_PER_IP=10
# QUOTE_REQUEST_WINDOW_SECONDS=3600
# Service requests (ADR-013): every request counts, per phone number and per network.
# SERVICE_REQUEST_MAX_PER_PHONE=3
# SERVICE_REQUEST_MAX_PER_IP=10
# SERVICE_REQUEST_WINDOW_SECONDS=3600
# Payments (module 15, §7 Q21): mock provider for mobile money until ADR-003. At least 32 characters;
# refused when APP_ENV=production. Unset: mobile-money payment answers 503. In development,
# scripts/mock_payment.py uses it to approve or fail a payment (it plays the provider).
# PAYMENT_MOCK_WEBHOOK_SECRET=
# PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# Continue with Google (ADR-006 amendment 2026-11-11): OAuth 2.0 / OpenID Connect, Authorization
# Code flow with PKCE. Off unless all three are set (the endpoints then answer 503
# google_auth_unavailable). Create a "Web application" OAuth client in Google Cloud Console and
# register GOOGLE_OAUTH_REDIRECT_URI on it exactly: the storefront route that receives Google's
# answer and forwards it to POST /api/v1/auth/google/callback. https:// outside development.
# Keep the client secret out of git; set it only in the environment of the API.
# GOOGLE_OAUTH_CLIENT_ID=<id>.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# A sign-in must finish within this many seconds of its start (60-1800).
# GOOGLE_OAUTH_FLOW_TTL_SECONDS=600
# Starts and failed callbacks allowed per client network per window.
# GOOGLE_AUTH_MAX_PER_NETWORK=30
# GOOGLE_AUTH_WINDOW_SECONDS=900

# Images: products, category images, brand logos (module 7; ADR-009). STORAGE_BACKEND: "local" is
# the only backend. MEDIA_ROOT (default backend/media, git-ignored) holds private/ (exact uploaded
# originals, never served) and public/ (sanitised public sources). IMAGE_PUBLIC_BASE_URL: public
# URL prefix of public/ (MEDIA_BASE_URL, the module 7 name, is still accepted). With
# APP_ENV=development the API serves public/ at /media; on staging/production a web server or CDN
# must serve it (not configured yet; hosting is decided in ADR-004).
# IMAGE_PROCESSING_CONCURRENCY: uploads processed with Pillow at once per API process.
STORAGE_BACKEND=local
# STORAGE_BACKEND=r2: Cloudflare R2 instead of MEDIA_ROOT. Two buckets: the public one (public
# r2.dev URL or custom domain = IMAGE_PUBLIC_BASE_URL) and a private one that is never public.
# The API token needs Object Read & Write on both. Existing local images:
# scripts/copy_media_to_r2.py. R2_ENDPOINT_URL is optional (EU-jurisdiction buckets).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BUCKET=
# R2_PRIVATE_BUCKET=
# R2_ENDPOINT_URL=
MEDIA_ROOT=media
IMAGE_PUBLIC_BASE_URL=http://localhost:8000/media
IMAGE_PROCESSING_CONCURRENCY=2

# Background worker (python -m app.worker, run next to the API; it uses DATABASE_URL and
# MEDIA_ROOT above). JOB_WORKER_CONCURRENCY: job items (bulk image upload) processed at once.
JOB_WORKER_CONCURRENCY=2

# ---- Development catalogue seed only (optional): scripts/seed_development_catalogue.py --------
# Passwords for the seed staff accounts (one per role) and the seed customers, all
# @seed.furnihub.local. Leave unset to get a random password per new account, printed once.
# 8+ characters with upper and lower case and a digit or symbol.
# SEED_STAFF_PASSWORD=CHANGE_ME
# SEED_CUSTOMER_PASSWORD=CHANGE_ME

# ---- Tests only (optional) -------------------------------------------------------------------
# Uncomment to run the database tests. Use a SEPARATE disposable database that must be named
# rwanda_ecommerce_test; tests/postgres drops and rebuilds its public schema. Never point these at
# your development data. Owner account, same port as above.
# TEST_DATABASE_URL=postgresql+psycopg://local_user:REPLACE_WITH_ROOT_ENV_POSTGRES_PASSWORD@127.0.0.1:5432/rwanda_ecommerce_test
# Redis database flushed between real-HTTP tests (keep it different from REDIS_URL's database).
# TEST_REDIS_URL=redis://127.0.0.1:6379/15

# ---- Smoke checks only (optional): scripts/verify_postgres_live.py -----------------------------
# The smoke script never uses DATABASE_URL / MIGRATION_DATABASE_URL. Point it at its own
# disposable database whose name ends in _test (never your development database), and repeat
# the database name in SMOKE_CONFIRM_DISPOSABLE to confirm it may be written to. Run
# provision_runtime_role.py against that database first (with its own runtime account).
# SMOKE_DATABASE_URL=postgresql+psycopg://rwanda_app_smoke:CHANGE_ME@127.0.0.1:5432/rwanda_smoke_test
# SMOKE_OWNER_DATABASE_URL=postgresql+psycopg://local_user:CHANGE_ME@127.0.0.1:5432/rwanda_smoke_test
# SMOKE_CONFIRM_DISPOSABLE=rwanda_smoke_test
# SMOKE_REDIS_URL=redis://127.0.0.1:6379/14

# Client IP for rate limits and audit records (ADR-006, 2026-11-13). Local development: "peer"
# (the default), the transport peer. Behind the storefront in staging and production: "signed",
# with the secret the storefront signs the shopper's address with (32+ characters; a different one
# per environment; never committed). CLIENT_IP_SIGNING_SECRET_NEXT only during a rotation. Run
# uvicorn with --no-proxy-headers there. Signatures older than the max age are refused.
# CLIENT_IP_SOURCE=peer
# CLIENT_IP_SIGNING_SECRET=
# CLIENT_IP_SIGNING_SECRET_NEXT=
# CLIENT_IP_SIGNATURE_MAX_AGE_SECONDS=60

# The marketplace's name (ADR-014 decision 16): the API's name and the emails' brand.
# MARKETPLACE_NAME=FurniHub
