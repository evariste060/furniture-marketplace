# Frontend settings. Copy this file to frontend/.env.local (git-ignored: never commit it).
# All of these except NEXT_PUBLIC_MARKETPLACE_NAME are read on the server only; the browser never calls the API directly (it goes
# through the /api/backend route handler of this app).

# Backend origin, without /api/v1. Server Components and the route handlers call it.
API_URL=http://127.0.0.1:8000

# Public origin of this site. Mutating requests to /api/* must come from it (Origin check).
# Optional in development (the request's own origin is used); required in production.
# Continue with Google needs no setting here: the backend holds the Google client, and its
# GOOGLE_OAUTH_REDIRECT_URI must be this origin + /api/auth/google/callback exactly.
SITE_URL=http://localhost:3000

# Image hosts allowed for next/image: comma-separated URL patterns. In development, the API's
# /media folder. A local host here also lets the image optimizer fetch from it. Restart or
# rebuild after a change.
IMAGE_REMOTE_PATTERNS=http://localhost:8000/media/**

# The marketplace's name (ADR-014 decision 16), shown in the logo, titles and messages. Optional:
# FurniHub by default. Public (built into the pages); keep it equal to the backend's
# MARKETPLACE_NAME. Rebuild after a change.
# NEXT_PUBLIC_MARKETPLACE_NAME=FurniHub

# Development only: show the component gallery at /dev/ui in a production build
# (the end-to-end tests use it). It is always available under `next dev`.
# ENABLE_DEV_UI=true

# End-to-end tests only (npx playwright test): the admin tests sign in as staff. The password of
# the seed staff accounts (backend SEED_STAFF_PASSWORD); without it the admin tests are skipped.
# The emails default to the seed accounts (admin@, sales@, finance@seed.furnihub.local).
# E2E_STAFF_PASSWORD=CHANGE_ME
# E2E_ADMIN_EMAIL=admin@seed.furnihub.local
# E2E_SALES_EMAIL=sales@seed.furnihub.local
# E2E_FINANCE_EMAIL=finance@seed.furnihub.local

# Client IP (ADR-006, 2026-11-13): leave unset in local development (nothing is sent; the API uses
# its transport peer). On Vercel: CLIENT_IP_SOURCE=vercel and CLIENT_IP_SIGNING_SECRET equal to the
# API's secret, server-only (never NEXT_PUBLIC_), a different one for Preview and Production.
# CLIENT_IP_SOURCE=vercel
# CLIENT_IP_SIGNING_SECRET=
