# Read on the server only; the browser reaches the API through this app's /api/backend route.
# Backend origin, without /api/v1. Without it every proxied request answers 502.
API_URL=https://API_DOMAIN
# Public origin of this site; required in production (Origin check on mutating requests).
SITE_URL=https://STORE_DOMAIN
# Image hosts allowed for next/image, comma-separated. Set before the build: next.config.ts reads it.
IMAGE_REMOTE_PATTERNS=https://MEDIA_DOMAIN/**

# Client IP (ADR-006, 2026-11-13): server-only, never NEXT_PUBLIC_. The production secret equals the
# production API's CLIENT_IP_SIGNING_SECRET (or its _NEXT during a rotation); never the same secret as
# another environment. next build and next start refuse a missing or short secret.
CLIENT_IP_SOURCE=vercel
CLIENT_IP_SIGNING_SECRET=CHANGE_ME_PRODUCTION_CLIENT_IP_SIGNING_SECRET
