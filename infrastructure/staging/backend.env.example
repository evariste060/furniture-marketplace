APP_NAME=Rwanda Electronics E-Commerce API
APP_ENV=staging
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DATABASE_HOST:5432/rwanda_ecommerce
CORS_ORIGINS=https://STORE_DOMAIN
# Runtime role (least privilege). Create with scripts/provision_runtime_role.py after migrations.
# MIGRATION_DATABASE_URL is the schema-owner role used only by Alembic; omit to reuse DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql+psycopg://OWNER:PASSWORD@DATABASE_HOST:5432/rwanda_ecommerce
# Shared login rate-limit store (all API workers/instances must use the same Redis).
REDIS_URL=redis://REDIS_HOST:6379/0
# 32+ char random secret for audit/rate-limit identifier pseudonyms. Rotating it breaks linkage
# with older audit records. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
AUDIT_HMAC_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
# Images (module 7; ADR-009; docs/deployment/media.md). STORAGE_BACKEND: "local" is the only
# backend today. MEDIA_ROOT: absolute path of the persistent folder the API writes images to; it
# must survive redeploys, be included in backups and be shared by every API instance. It holds
# private/ (exact originals, never served) and public/ (sanitised public sources).
# IMAGE_PUBLIC_BASE_URL: public https:// URL at which a web server or CDN serves MEDIA_ROOT/public
# (the API does not serve it outside development; the API refuses to start with a non-https or
# loopback value). Serving and storage are decided in ADR-004.
STORAGE_BACKEND=local
MEDIA_ROOT=/ABSOLUTE/PATH/TO/PERSISTENT/MEDIA
IMAGE_PUBLIC_BASE_URL=https://STAGING_MEDIA_DOMAIN/media
# Messages: mock records order notifications and delivers nothing (password reset answers 503);
# smtp sends real email and cannot send SMS. Inject the password from the secret store.
NOTIFICATION_PROVIDER=mock

# SMTP (only with NOTIFICATION_PROVIDER=smtp). Gmail: turn on 2-Step Verification and create an app
# password; never use the account password. Keep the password in this git-ignored file or a secret
# store, and never commit it. STARTTLS with a verified certificate is required when credentials
# are set.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_TIMEOUT_SECONDS=10

# Client IP (ADR-006, 2026-11-13): the storefront signs the shopper's address; the API accepts it
# only with a valid, fresh signature. Required behind the storefront. Start uvicorn with
# --no-proxy-headers. The staging secret (32+ random characters, in the host's secret store only)
# must equal the staging storefront's CLIENT_IP_SIGNING_SECRET. _NEXT only during a rotation.
CLIENT_IP_SOURCE=signed
CLIENT_IP_SIGNING_SECRET=CHANGE_ME_STAGING_CLIENT_IP_SIGNING_SECRET
# CLIENT_IP_SIGNING_SECRET_NEXT=
